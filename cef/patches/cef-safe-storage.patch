+extern "C" CEF_EXPORT int cef_set_os_crypt_keys(
+    const uint8_t* current_key,
+    size_t current_key_size,
+    const uint8_t* legacy_key,
+    size_t legacy_key_size) {
+#if BUILDFLAG(IS_MAC)
+  if (!current_key || current_key_size != 16 ||
+      (legacy_key_size != 0 && (!legacy_key || legacy_key_size != 16))) {
+    return 0;
+  }
+  std::string keys(reinterpret_cast<const char*>(current_key),
+                   current_key_size);
+  if (legacy_key_size == 16) {
+    keys.append(reinterpret_cast<const char*>(legacy_key), legacy_key_size);
+  }
+  OSCrypt::SetRawEncryptionKey(keys);
+  return 1;
+#else
+  return 0;
+#endif
+}

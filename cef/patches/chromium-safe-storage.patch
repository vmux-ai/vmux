+bool KeychainKeyProvider::SetRawEncryptionKeys(const uint8_t* current_key,
+                                               size_t current_key_size,
+                                               const uint8_t* legacy_key,
+                                               size_t legacy_key_size) {
+  if (!current_key || current_key_size != kDerivedKeySize ||
+      (legacy_key_size != 0 &&
+       (!legacy_key || legacy_key_size != kDerivedKeySize))) {
+    return false;
+  }
+  RawEncryptionKey().emplace();
+  base::span(*RawEncryptionKey())
+      .copy_from(base::span(current_key, current_key_size));
+  LegacyRawEncryptionKey().reset();
+  if (legacy_key_size != 0) {
+    LegacyRawEncryptionKey().emplace();
+    base::span(*LegacyRawEncryptionKey())
+        .copy_from(base::span(legacy_key, legacy_key_size));
+  }
+  return true;
+}

# Relay used by Remote to reach this Mac from a phone off the local network.
# Defaults to https://relay.vmux.ai; point it at a local relay to develop against one.
# Set it empty to switch the relay off and pair over loopback, which is what the
# iOS Simulator needs.
# VMUX_REMOTE_RELAY_URL=https://localhost:8788

# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (XXXXXXXXXX)
# APPLE_ID=your@email.com
# APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# VMUX_UPDATE_PRIVATE_KEY=
# VMUX_UPDATE_PRIVATE_KEY_PASSWORD=

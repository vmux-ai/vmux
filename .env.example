# Relay used by Remote to reach this Mac from a phone. There is no way to switch it off:
# a Mac behind NAT cannot be dialled directly, so every pairing goes through one.
#
# Defaults to https://relay.vmux.ai. Point it at the local stack (`make cloud` in
# vmux-cloud) to develop against that instead. 8787 is the relay's QUIC control port;
# the URL is spelled https because it names a host and port, not because anything
# terminates TLS over TCP there.
# VMUX_REMOTE_RELAY_URL=https://localhost:8787

# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (XXXXXXXXXX)
# APPLE_ID=your@email.com
# APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# VMUX_UPDATE_PRIVATE_KEY=
# VMUX_UPDATE_PRIVATE_KEY_PASSWORD=

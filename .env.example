# Relay used by Remote to reach this Mac from a phone. There is no way to switch it off:
# a Mac behind NAT cannot be dialled directly, so every pairing goes through one.
#
# Defaults to https://relay.vmux.ai. Point it at the local stack (`make cloud` in
# vmux-cloud) to develop against that instead. 8787 is the relay's QUIC control port;
# the URL is spelled https because it names a host and port, not because anything
# terminates TLS over TCP there.
# VMUX_REMOTE_RELAY_URL=https://localhost:8787

# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (XXXXXXXXXX)
# APPLE_ID=your@email.com
# APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# VMUX_UPDATE_PRIVATE_KEY=
# VMUX_UPDATE_PRIVATE_KEY_PASSWORD=

# iOS App Store signing, used by scripts/build-ios-release.sh. Separate from the pair above:
# APPLE_CERTIFICATE is a Developer ID certificate and cannot sign for the App Store. These need
# an Apple Distribution certificate and a provisioning profile for ai.vmux.mobile, each base64
# of the raw file. APPLE_ID, APPLE_APP_PASSWORD and APPLE_TEAM_ID are shared with macOS.
#
# Encode each on ONE line — `base64 -i file | tr -d '\n'`. This file is read line by line, so a
# wrapped value is silently truncated at the first newline and fails later as a bad certificate
# or a profile that will not decode, nowhere near the paste that caused it.
# APPLE_IOS_SIGNING_IDENTITY=Apple Distribution: Your Name (XXXXXXXXXX)
# APPLE_IOS_CERTIFICATE=
# APPLE_IOS_CERTIFICATE_PASSWORD=
# APPLE_IOS_PROVISIONING_PROFILE=

# App Store Connect API key, used by scripts/submit-ios-release.sh to promote a TestFlight build
# to review. Separate from the signing certificate above: altool can upload but cannot submit.
# Leave these unset and the build still reaches TestFlight; only the submission step is skipped.
# APPLE_ASC_KEY_ID=XXXXXXXXXX
# APPLE_ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# APPLE_ASC_PRIVATE_KEY=

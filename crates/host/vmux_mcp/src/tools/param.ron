[
    (
        kind: open_command_bar,
        description: "Open the Vmux command bar.",
        input_schema: (
            type: Object,
            properties: {
                "mode": (type: String, values: ["default", "commands", "path"]),
            },
        ),
    ),
    (
        kind: browser_navigate,
        description: "Navigate the active webview to a URL, or open a URL in a target pane. This is the primary tool for web access. When navigating the focused browser page, it returns the page semantic snapshot after loading. vmux://terminal/ opens a terminal, vmux://spaces/ opens spaces, and vmux://services/ opens the process monitor. Other vmux:// URLs are rejected.",
        input_schema: (
            type: Object,
            required: ["url"],
            properties: {
                "url": (type: String),
                "pane": (type: String),
            },
        ),
    ),
    (
        kind: terminal_send,
        description: "Send text to a terminal. Target by terminal process ID or omit it to use the active terminal. Set enter to true to append a carriage return.",
        input_schema: (
            type: Object,
            required: ["text"],
            properties: {
                "text": (type: String),
                "terminal": (type: String),
                "enter": (type: Boolean),
            },
        ),
    ),
    (
        kind: rename_profile,
        description: "Rename the active profile display name without changing its storage.",
        input_schema: (
            type: Object,
            required: ["name"],
            properties: {"name": (type: String)},
        ),
    ),
    (
        kind: select_tab,
        description: "Select a tab by index from 1 through 8.",
        input_schema: (
            type: Object,
            required: ["index"],
            properties: {
                "index": (type: Integer, minimum: Some(1), maximum: Some(8)),
            },
        ),
    ),
    (
        kind: update_settings,
        description: "Update one vmux setting by dot path. Use get_settings to discover available paths and current values. Nested arrays use bracket indexing such as terminal.themes[0].font_size.",
        input_schema: (
            type: Object,
            required: ["path", "value"],
            properties: {
                "path": (type: String),
                "value": (description: Some("JSON-compatible setting value.")),
            },
        ),
    ),
    (
        kind: browser_go_back,
        description: "Navigate the active or specified browser pane back one page in history.",
        input_schema: (
            type: Object,
            properties: {"pane": (type: String)},
        ),
    ),
    (
        kind: browser_go_forward,
        description: "Navigate the active or specified browser pane forward one page in history.",
        input_schema: (
            type: Object,
            properties: {"pane": (type: String)},
        ),
    ),
    (
        kind: browser_history_search,
        description: "Search vmux browsing history. Returns entries ranked by frecency.",
        input_schema: (
            type: Object,
            required: ["query"],
            properties: {
                "query": (type: String),
                "limit": (type: Integer, minimum: Some(0), maximum: Some(100)),
            },
        ),
    ),
    (
        kind: browser_install_extension,
        description: "Install a browser extension from a supported extension-store URL or a 32-character extension ID. The extension activates after the next vmux relaunch and runs only in windowed browse panes on macOS.",
        input_schema: (
            type: Object,
            required: ["source"],
            properties: {"source": (type: String)},
        ),
    ),
    (
        kind: create_space,
        description: "Create a new space and switch to it. An omitted name is generated automatically.",
        input_schema: (
            type: Object,
            properties: {"name": (type: String)},
        ),
    ),
    (
        kind: rename_space,
        description: "Rename a space by stable ID. Use list_spaces to discover IDs.",
        input_schema: (
            type: Object,
            required: ["space_id", "name"],
            properties: {
                "space_id": (type: String),
                "name": (type: String),
            },
        ),
    ),
    (
        kind: delete_space,
        description: "Delete a space by stable ID. Use list_spaces to discover IDs.",
        input_schema: (
            type: Object,
            required: ["space_id"],
            properties: {"space_id": (type: String)},
        ),
    ),
    (
        kind: notify,
        description: "Notify the user that the agent needs attention. Optional title and body customize the message.",
        input_schema: (
            type: Object,
            properties: {
                "title": (type: String),
                "body": (type: String),
            },
        ),
    ),
]

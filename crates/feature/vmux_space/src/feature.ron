(
    settings: Some((
        sections: [(
            id: "spaces",
            title: "spaces-title",
            root_path: "spaces",
            order: 90,
        )],
        fields: [
            (
                path: "spaces.*.startup_url",
                label: Some("schema-startup-url"),
            ),
            (
                path: "spaces.*.startup_dir",
                label: Some("schema-startup-directory"),
            ),
        ],
    )),
    pages: [
        (
            url: "vmux://spaces/",
            title: "Spaces",
            bookmark: Some(90),
            title_message_id: "spaces-title",
            keywords: ["space"],
            icon: "Layers",
            command_bar: true,
            permissions: [
                "PageReady",
                "ThemeEvent",
                "SpacesUiState",
                "SpaceOpenPageRequest",
                "SpaceAttachRequest",
                "SpaceDeleteRequest",
                "SpaceRenameRequest",
                "SpaceCreateRequest",
                "SpaceFormOpenRequest",
                "SpaceFormInputRequest",
                "SpaceFormCloseRequest",
                "ProjectForgetRequest",
                "ProjectActivateRequest",
                "TeamEvent",
                "TeamOpenRequest",
                "TeamMemberFocusRequest",
                "TeamProfileCreateRequest",
                "TeamProfileSwitchRequest",
                "TeamProfileUpdateRequest",
                "UiKeyContext",
                "KeyStroke",
                "KeyClaims",
            ],
        ),
    ],
    tools: [
            (
                name: "select_project",
                aliases: ["select_workspace", "choose_workspace"],
                description: r#"Select a project before accessing its files or running project commands. Pass a known path or omit it to open the native project picker rooted at ~/.vmux/projects. Paths inside ~/.vmux/projects are selected immediately. Paths outside it require explicit user approval in the native picker. For a new project, first use request_user_choice to offer a concrete suggested location and Choose existing project; do not ask the user to invent a folder. Use ~/.vmux/projects/<remote-host>/<organization>/<repository> when a remote is known and ~/.vmux/projects/local/<project> otherwise. When creation is selected, use run only to create the empty directory, then call this tool with that path. vmux offers Git initialization and uses the new project root directly without a linked worktree. For a previously existing Git project, call create_worktree immediately before the first mutation. The request returns immediately when user selection is needed: stop the current turn and do not call again while pending. Do not search the user's home directory. Do not call for general questions or self-contained terminal demonstrations."#,
                input_schema: (
                    type: Object,
                    properties: {"path": (type: String)},
                ),
            ),
            (
                name: "create_worktree",
                description: r#"Call immediately before the first edit, write, test, build, or other project mutation, after a Git project is selected. Never call for requests that only read, show, search, or explain existing files. vmux reuses the current linked worktree, accepts a known existing worktree path, automatically uses a single unambiguous existing worktree, or creates a managed worktree when none exists. If multiple existing worktrees are returned as ambiguous, ask the user with request_user_choice to choose an existing path or Create new worktree; call again with path or create=true. Never run git worktree add manually. Returns the absolute worktree path."#,
                input_schema: (
                    type: Object,
                    properties: {
                        "branch": (type: String),
                        "path": (type: String),
                        "task": (type: String),
                        "create": (type: Boolean),
                    },
                ),
            ),
            (
                name: "list_spaces",
                description: "List all spaces as a JSON array of { id, name, profile, is_active }. Use the `id` with rename_space / delete_space.",
                input_schema: (type: Object),
            ),
            (
                name: "create_space",
                description: "Create a new space and switch to it. An omitted name is generated automatically.",
                input_schema: (
                    type: Object,
                    properties: {"name": (type: String)},
                ),
            ),
            (
                name: "rename_space",
                description: "Rename a space by stable ID. Use list_spaces to discover IDs.",
                input_schema: (
                    type: Object,
                    required: ["space_id", "name"],
                    properties: {
                        "space_id": (type: String),
                        "name": (type: String),
                    },
                ),
            ),
            (
                name: "delete_space",
                description: "Delete a space by stable ID. Use list_spaces to discover IDs.",
                input_schema: (
                    type: Object,
                    required: ["space_id"],
                    properties: {"space_id": (type: String)},
                ),
            ),
    ],
    commands: [
            (
                id: "space_open",
                label: "Open",
                group: "Layout > Space",
                shortcuts: [(shortcut: Chord("Ctrl+b, s"), when: None)],
            ),
            (
                id: "space_next",
                label: "Next Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowDown"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+n"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+j"), when: Some("spaces")),
                ],
            ),
            (
                id: "space_previous",
                label: "Previous Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowUp"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+p"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+k"), when: Some("spaces")),
                ],
            ),
            (
                id: "space_attach",
                label: "Open Selected Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [(shortcut: Direct("Enter"), when: Some("spaces"))],
            ),
            (
                id: "space_delete",
                label: "Delete Selected Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("Delete"), when: Some("spaces")),
                    (shortcut: Direct("Backspace"), when: Some("spaces")),
                ],
            ),
            (
                id: "open_in_new_space",
                label: "Open in New Space",
                group: "Browser > Open",
                accelerator: Some("super+shift+n"),
                mcp: Some((
                    description: "Open a page in a brand-new Space (top-level profile). Spaces are the highest-level container and each carries its own profile (cookies, identity, theme). Use only when the user explicitly asks for a new profile, a separate identity, or a top-level workspace switch.",
                    input_schema: Some((
                        type: Object,
                        properties: {
                            "url": (
                                type: String,
                                description: Some("Absolute URL to open in the new Space. If omitted, opens the startup URL."),
                            ),
                        },
                    )),
                )),
            ),
    ],
)

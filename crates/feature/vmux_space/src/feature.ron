(
    pages: {
        "default":
        (
            url: "vmux://spaces/",
            title: "Spaces",
            title_message_id: "spaces-title",
            keywords: ["space"],
            icon: "Layers",
            command_bar: true,
            permissions: [
                "PageReady",
                "ThemeEvent",
                "SpacesUiState",
                "SpaceOpenPageRequest",
                "SpaceAttachRequest",
                "SpaceDeleteRequest",
                "SpaceRenameRequest",
                "SpaceCreateRequest",
                "ProjectForgetRequest",
                "ProjectActivateRequest",
                "TeamEvent",
                "TeamOpenRequest",
                "TeamMemberFocusRequest",
                "TeamProfileCreateRequest",
                "TeamProfileSwitchRequest",
                "TeamProfileUpdateRequest",
                "UiKeyContext",
                "KeyStroke",
                "KeyClaims",
            ],
        )
        ,
    },
    tools: {
        "default":
        [
            (
                name: "list_spaces",
                description: "List all spaces as a JSON array of { id, name, profile, is_active }. Use the `id` with rename_space / delete_space.",
                input_schema: (type: Object),
            ),
            (
                name: "create_space",
                description: "Create a new space and switch to it. An omitted name is generated automatically.",
                input_schema: (
                    type: Object,
                    properties: {"name": (type: String)},
                ),
            ),
            (
                name: "rename_space",
                description: "Rename a space by stable ID. Use list_spaces to discover IDs.",
                input_schema: (
                    type: Object,
                    required: ["space_id", "name"],
                    properties: {
                        "space_id": (type: String),
                        "name": (type: String),
                    },
                ),
            ),
            (
                name: "delete_space",
                description: "Delete a space by stable ID. Use list_spaces to discover IDs.",
                input_schema: (
                    type: Object,
                    required: ["space_id"],
                    properties: {"space_id": (type: String)},
                ),
            ),
        ]
        ,
    },
    commands: {
        "key":
        [
            (
                id: "space_next",
                label: "Next Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowDown"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+n"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+j"), when: Some("spaces")),
                ],
            ),
            (
                id: "space_previous",
                label: "Previous Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowUp"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+p"), when: Some("spaces")),
                    (shortcut: Direct("Ctrl+k"), when: Some("spaces")),
                ],
            ),
            (
                id: "space_attach",
                label: "Open Selected Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [(shortcut: Direct("Enter"), when: Some("spaces"))],
            ),
            (
                id: "space_delete",
                label: "Delete Selected Space",
                group: "Layout > Space",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("Delete"), when: Some("spaces")),
                    (shortcut: Direct("Backspace"), when: Some("spaces")),
                ],
            ),
        ]
        ,
        "plugin":
        [
            (
                id: "open_in_new_space",
                label: "Open in New Space",
                group: "Browser > Open",
                accelerator: Some("super+shift+n"),
                mcp: Some((
                    description: "Open a page in a brand-new Space (top-level profile). Spaces are the highest-level container and each carries its own profile (cookies, identity, theme). Use only when the user explicitly asks for a new profile, a separate identity, or a top-level workspace switch.",
                    input_schema: Some((
                        type: Object,
                        properties: {
                            "url": (
                                type: String,
                                description: Some("Absolute URL to open in the new Space. If omitted, opens the startup URL."),
                            ),
                        },
                    )),
                )),
            ),
        ]
        ,
    },
)

(
    url: "vmux://services/",
    title: "Services",
    title_message_id: "services-title",
    replaces_command: "service_open",
    keywords: ["processes", "monitor"],
    icon: "Activity",
    command_bar: true,
    manifest: true,
    permissions: [
        "PageReady",
        "ThemeEvent",
        "ProcessesUiState",
        "ProcessNavigateEvent",
        "ProcessKillEvent",
        "ProcessKillAllEvent",
    ],
)

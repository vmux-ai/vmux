(
    tool_providers: [
        (id: "lsp", title: "LSP Servers", title_message_id: "tools-provider-lsp-servers", route_title: "LSP", route_title_message_id: "tools-provider-lsp-servers", short_label: "lsp", route: "lsp", rank: 10),
    ],
    policies: Some((
        lsp: (
            servers: [
                (extensions: ["rs"], command: "rust-analyzer", language_id: "rust", root_markers: ["Cargo.toml", ".git"], package: Some("rust-analyzer")),
                (extensions: ["py", "pyi"], command: "pyright-langserver", args: ["--stdio"], language_id: "python", root_markers: ["pyproject.toml", "setup.py", ".git"], package: Some("pyright")),
                (extensions: ["ts"], command: "typescript-language-server", args: ["--stdio"], language_id: "typescript", root_markers: ["package.json", "tsconfig.json", ".git"], package: Some("typescript-language-server")),
                (extensions: ["tsx"], command: "typescript-language-server", args: ["--stdio"], language_id: "typescriptreact", root_markers: ["package.json", "tsconfig.json", ".git"], package: Some("typescript-language-server")),
                (extensions: ["js"], command: "typescript-language-server", args: ["--stdio"], language_id: "javascript", root_markers: ["package.json", ".git"], package: Some("typescript-language-server")),
                (extensions: ["jsx"], command: "typescript-language-server", args: ["--stdio"], language_id: "javascriptreact", root_markers: ["package.json", ".git"], package: Some("typescript-language-server")),
                (extensions: ["go"], command: "gopls", language_id: "go", root_markers: ["go.mod", ".git"], package: Some("gopls")),
                (extensions: ["c", "h"], command: "clangd", language_id: "c", root_markers: ["compile_commands.json", ".git"], package: Some("clangd")),
                (extensions: ["cpp", "cc", "cxx", "hpp", "hh"], command: "clangd", language_id: "cpp", root_markers: ["compile_commands.json", ".git"], package: Some("clangd")),
                (extensions: ["lua"], command: "lua-language-server", language_id: "lua", root_markers: [".luarc.json", ".git"], package: Some("lua-language-server")),
                (extensions: ["rb"], command: "solargraph", args: ["stdio"], language_id: "ruby", root_markers: ["Gemfile", ".git"], package: Some("solargraph")),
                (extensions: ["zig"], command: "zls", language_id: "zig", root_markers: ["build.zig", ".git"], package: Some("zls")),
                (extensions: ["sh", "bash"], command: "bash-language-server", args: ["start"], language_id: "shellscript", root_markers: [".git"], package: Some("bash-language-server")),
                (extensions: ["json"], command: "vscode-json-language-server", args: ["--stdio"], language_id: "json", root_markers: [".git"], package: Some("json-lsp")),
                (extensions: ["yaml", "yml"], command: "yaml-language-server", args: ["--stdio"], language_id: "yaml", root_markers: [".git"], package: Some("yaml-language-server")),
                (extensions: ["toml"], command: "taplo", args: ["lsp", "stdio"], language_id: "toml", root_markers: [".git"], package: Some("taplo")),
                (extensions: ["md", "markdown"], command: "marksman", args: ["server"], language_id: "markdown", root_markers: [".git"], package: Some("marksman")),
                (extensions: ["java"], command: "jdtls", language_id: "java", root_markers: ["pom.xml", "build.gradle", ".git"], package: Some("jdtls")),
            ],
            linters: [
                (extensions: ["py", "pyi"], command: "ruff", args: ["check", "--output-format", "json"], format: Ruff),
                (extensions: ["js", "jsx", "ts", "tsx"], command: "eslint", args: ["--format", "json"], format: Eslint),
                (extensions: ["sh", "bash"], command: "shellcheck", args: ["--format", "json"], format: Shellcheck),
            ],
        ),
    )),

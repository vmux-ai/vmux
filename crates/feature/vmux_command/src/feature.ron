(
    tools: [
            (
                name: "open_command_bar",
                description: "Open the Vmux command bar.",
                input_schema: (
                    type: Object,
                    properties: {
                        "mode": (type: String, values: ["default", "commands", "path"]),
                    },
                ),
            ),
            (
                name: "notify",
                description: "Notify the user that the agent needs attention. Optional title and body customize the message.",
                input_schema: (
                    type: Object,
                    properties: {
                        "title": (type: String),
                        "body": (type: String),
                    },
                ),
            ),
    ],
    commands: [
            (
                id: "browser_open_command_bar",
                label: "Command Bar",
                group: "Browser > Bar",
                accelerator: Some("super+k"),
                shortcuts: [
                    (shortcut: Direct("Super+k"), when: None),
                    (shortcut: Direct("Super+p"), when: None),
                ],
                mcp: Some((description: "Command Bar")),
            ),
            (
                id: "browser_open_page_in_command_bar",
                label: "Edit Page",
                group: "Browser > Bar",
                accelerator: Some("super+l"),
                shortcuts: [(shortcut: Direct("Super+l"), when: None)],
                mcp: Some((description: "Edit Page")),
            ),
            (
                id: "browser_open_path_bar",
                label: "Path Navigator",
                group: "Browser > Bar",
                accelerator: Some("super+/"),
                shortcuts: [(shortcut: Direct("Super+/"), when: None)],
                mcp: Some((description: "Path Navigator")),
            ),
            (
                id: "browser_open_commands",
                label: "Commands",
                group: "Browser > Bar",
                shortcuts: [(shortcut: Direct(">"), when: None)],
                mcp: Some((description: "Commands")),
            ),
            (
                id: "command_bar_next",
                label: "Next Result",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowDown"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                    (shortcut: Direct("Ctrl+n"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                    (shortcut: Direct("Ctrl+j"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                ],
            ),
            (
                id: "command_bar_previous",
                label: "Previous Result",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowUp"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                    (shortcut: Direct("Ctrl+p"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                    (shortcut: Direct("Ctrl+k"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                ],
            ),
            (
                id: "command_bar_home",
                label: "Move to Beginning",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+a"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_end",
                label: "Move to End",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+e"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_forward",
                label: "Move Forward",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+f"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_back",
                label: "Move Back",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+b"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_delete",
                label: "Delete Forward",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+d"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_backspace",
                label: "Delete Backward",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+h"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_delete_word",
                label: "Delete Word",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+w"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_delete_to_beginning",
                label: "Delete to Beginning",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Ctrl+u"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_complete",
                label: "Accept Completion",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Tab"), when: Some("command-bar"))],
            ),
            (
                id: "command_bar_dismiss",
                label: "Dismiss Command Bar",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("Escape"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                    (shortcut: Direct("Ctrl+c"), when: Some("command-bar && !command-bar.menu && !command-bar.media")),
                ],
            ),
            (
                id: "command_bar_submit",
                label: "Submit Command Bar",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Enter"), when: Some("command-bar && !command-bar.menu && !command-bar.media"))],
            ),
            (
                id: "command_bar_menu_next",
                label: "Next Command Bar Menu Option",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowDown"), when: Some("command-bar.menu")),
                    (shortcut: Direct("Ctrl+n"), when: Some("command-bar.menu")),
                    (shortcut: Direct("Ctrl+j"), when: Some("command-bar.menu")),
                ],
            ),
            (
                id: "command_bar_menu_previous",
                label: "Previous Command Bar Menu Option",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowUp"), when: Some("command-bar.menu")),
                    (shortcut: Direct("Ctrl+p"), when: Some("command-bar.menu")),
                    (shortcut: Direct("Ctrl+k"), when: Some("command-bar.menu")),
                ],
            ),
            (
                id: "command_bar_menu_choose",
                label: "Choose Command Bar Menu Option",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Enter"), when: Some("command-bar.menu"))],
            ),
            (
                id: "command_bar_menu_dismiss",
                label: "Dismiss Command Bar Menu",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("Escape"), when: Some("command-bar.menu")),
                    (shortcut: Direct("Ctrl+c"), when: Some("command-bar.menu")),
                ],
            ),
            (
                id: "command_bar_media_next",
                label: "Next Command Bar Media Option",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowDown"), when: Some("command-bar.media")),
                    (shortcut: Direct("Ctrl+n"), when: Some("command-bar.media")),
                    (shortcut: Direct("Ctrl+j"), when: Some("command-bar.media")),
                ],
            ),
            (
                id: "command_bar_media_previous",
                label: "Previous Command Bar Media Option",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("ArrowUp"), when: Some("command-bar.media")),
                    (shortcut: Direct("Ctrl+p"), when: Some("command-bar.media")),
                    (shortcut: Direct("Ctrl+k"), when: Some("command-bar.media")),
                ],
            ),
            (
                id: "command_bar_media_choose",
                label: "Choose Command Bar Media Option",
                group: "Command Bar",
                hidden: true,
                shortcuts: [(shortcut: Direct("Enter"), when: Some("command-bar.media"))],
            ),
            (
                id: "command_bar_media_dismiss",
                label: "Dismiss Command Bar Media",
                group: "Command Bar",
                hidden: true,
                shortcuts: [
                    (shortcut: Direct("Escape"), when: Some("command-bar.media")),
                    (shortcut: Direct("Ctrl+c"), when: Some("command-bar.media")),
                ],
            ),
    ],
)

(
    pages: [
        (
            url: "vmux://sessions/",
            title: "Sessions",
            owns_subtree: true,
            reports_title: true,
            placement: Some((
                group: "assistant",
                auxiliary: true,
                reuse: Route,
            )),
            keywords: ["ai", "chat", "assistant", "agent"],
            icon: "Sparkles",
            permissions: [
                "PageReady",
                "ThemeUiState",
                "ChatUiState",
                "SelectMode",
                "ChatHistoryMoreRequest",
                "ChatSubmit",
                "ChatDraftChanged",
                "ChatRemoveAttachment",
                "ChatChoiceSelected",
                "ChatListSelectionChanged",
                "ChatApproval",
                "ChatComposerMenuRequest",
                "ChatDismissSelectorRequest",
                "ChatCancel",
                "ChatStop",
                "ChatResume",
                "ChatClearQueue",
                "ChatCancelQueuedPrompt",
                "ChatEscape",
                "ChatSlashCommandRequest",
                "ChatSelectWorkspace",
                "ChatBranchesRequest",
                "ChatMediaQueryRequest",
                "ChatResumeQueryRequest",
                "ChatGoToBranch",
                "SelectModel",
                "SetAgentEffort",
                "ChatOpenPage",
                "SessionsCreate",
                "SessionsChooseDirectory",
                "SessionsRename",
                "SessionsDescriptionUpdate",
                "SessionsStageChange",
                "SessionsCleanup",
                "PromptHistoryRequest",
                "ResumeListRequest",
                "ResumeSession",
                "McpServersRequest",
                "McpServerRequest",
                "McpServers",
                "ChatPickFiles",
                "ChatPasteMedia",
                "ChatMediaListRequest",
                "ChatAttachPaths",
                "AgentToast",
                "AgentInstallRunRequest",
                "AgentSetupPrereqRequest",
                "AgentSetupUiState",
                "KeyContextRequest",
                "KeyStroke",
                "KeyClaimsUiState",
            ],
        ),
    ],
    tools: [
            (
                name: "set_conversation_title",
                description: r#"Set the agent conversation header to a concise model-written summary without asking permission. Always call first after the first user message to replace the provisional raw-prompt title. On later messages, call first only when the topic materially changes. Use 3 to 7 words, correct spelling and grammar, and never copy the user's prompt verbatim."#,
                input_schema: (
                    type: Object,
                    required: ["title"],
                    properties: {
                        "title": (
                            type: String,
                            min_length: Some(1),
                            max_length: Some(120),
                        ),
                    },
                ),
            ),
            (
                name: "request_user_choice",
                description: r#"Show a native multiple-choice question in the agent conversation. For a new project without a selected project, use it to offer the concrete suggested ~/.vmux/projects path or Choose existing project. Also use it for other user-requested options and ambiguous worktree selection. Keep options concise and actionable. The user can choose with arrow keys, Ctrl+N/Ctrl+P, number keys, mouse, or Enter. The request returns immediately: stop the current turn; vmux resumes the same conversation with the selected option."#,
                input_schema: (
                    type: Object,
                    required: ["question", "options"],
                    properties: {
                        "question": (type: String),
                        "options": (
                            type: Array,
                            items: (type: String),
                            min_items: Some(2),
                            max_items: Some(9),
                        ),
                    },
                ),
            ),
    ],
    commands: [
          (
            id: "chat_list_next",
            label: "Next Option",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("ArrowDown"), when: Some("chat.list")),
              (shortcut: Direct("Ctrl+n"), when: Some("chat.list")),
              (shortcut: Direct("Ctrl+j"), when: Some("chat.list")),
            ],
          ),
          (
            id: "chat_list_previous",
            label: "Previous Option",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("ArrowUp"), when: Some("chat.list")),
              (shortcut: Direct("Ctrl+p"), when: Some("chat.list")),
              (shortcut: Direct("Ctrl+k"), when: Some("chat.list")),
            ],
          ),
          (
            id: "chat_list_choose",
            label: "Choose Option",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("Enter"), when: Some("chat.list")),
            ],
          ),
          (
            id: "chat_choice_1",
            label: "Choose First Option",
            group: "Chat",
            hidden: true,
            shortcuts: [(shortcut: Direct("1"), when: Some("chat.choice"))],
          ),
          (
            id: "chat_choice_2",
            label: "Choose Second Option",
            group: "Chat",
            hidden: true,
            shortcuts: [(shortcut: Direct("2"), when: Some("chat.choice"))],
          ),
          (
            id: "chat_choice_3",
            label: "Choose Third Option",
            group: "Chat",
            hidden: true,
            shortcuts: [(shortcut: Direct("3"), when: Some("chat.choice"))],
          ),
          (
            id: "chat_history_older",
            label: "Previous Prompt",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("ArrowUp"), when: Some("chat && !chat.list")),
              (shortcut: Direct("Ctrl+p"), when: Some("chat && !chat.list")),
            ],
          ),
          (
            id: "chat_history_newer",
            label: "Next Prompt",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("ArrowDown"), when: Some("chat && !chat.list")),
              (shortcut: Direct("Ctrl+n"), when: Some("chat && !chat.list")),
            ],
          ),
          (
            id: "chat_submit",
            label: "Send Prompt",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("Enter"), when: Some("chat && !chat.list")),
            ],
          ),
          (
            id: "chat_dismiss_selector",
            label: "Close Picker",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("Escape"), when: Some("chat.selector")),
            ],
          ),
          (
            id: "chat_interrupt",
            label: "Send Queued Now",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("Escape"), when: Some("chat && !chat.selector")),
            ],
          ),
          (
            id: "chat_cancel",
            label: "Stop Turn",
            group: "Chat",
            hidden: true,
            shortcuts: [
              (shortcut: Direct("Ctrl+c"), when: Some("chat")),
            ],
          ),
    ],
    session: (
        default_stage: "in_progress",
        stages: [
            (id: "in_progress", name: "session-stage-in-progress", terminal: false, order: 10),
            (id: "in_review", name: "session-stage-in-review", terminal: false, order: 20),
            (id: "done", name: "session-stage-done", terminal: true, order: 30),
            (id: "canceled", name: "session-stage-canceled", terminal: true, order: 40),
        ],
    ),
)

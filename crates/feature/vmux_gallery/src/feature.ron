            "GalleryProgressRequest", "GalleryClickRequest", "GalleryResetRequest",
            "GalleryMenuRequest", "GalleryCursorRequest", "GalleryAgentRequest",
            "GalleryModelRequest", "GalleryEffortRequest", "GalleryPermissionRequest",
            "GalleryProjectRequest", "GalleryBranchRequest", "GallerySubmitRequest",
            "GalleryStopRequest", "GalleryAttachRequest", "GalleryRemoveAttachmentRequest",
            "GalleryPasteRequest", "GalleryStatusRequest", "GalleryConfigureRequest", "GalleryPresetRequest",
        ],
    )],
)

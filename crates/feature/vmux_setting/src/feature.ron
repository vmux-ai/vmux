(
    pages: {
        "default":
        (
            url: "vmux://settings/",
            title: "Settings",
            title_message_id: "settings-title",
            keywords: ["preferences", "config"],
            icon: "Settings",
            command_bar: true,
            permissions: [
                "PageReady",
                "ThemeEvent",
                "SettingsUiState",
                "CheckForUpdatesEvent",
                "SettingsRequest",
            ],
        )
        ,
    },
    tools: {
        "default":
        [
            (
                name: "get_settings",
                description: "Return the full vmux settings as a JSON snapshot.",
                input_schema: (type: Object),
            ),
            (
                name: "update_settings",
                description: "Update one vmux setting by dot path. Use get_settings to discover available paths and current values. Nested arrays use bracket indexing such as terminal.themes[0].font_size.",
                input_schema: (
                    type: Object,
                    required: ["path", "value"],
                    properties: {
                        "path": (type: String),
                        "value": (description: Some("JSON-compatible setting value.")),
                    },
                ),
            ),
        ]
        ,
    },
    commands: {
        "state":
        [
            (
                id: "open_settings",
                label: "Settings",
                group: "Layout > Window",
                hidden: true,
                shortcuts: [(shortcut: Direct("Super+,"), when: None)],
            ),
        ]
        ,
    },
)

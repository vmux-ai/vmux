        "ToolsRefreshRequest",
        "ToolOpenRequest",
        "ToolsNavigateRequest",
        "ToolInstallRequest",
        "ToolUpdateRequest",
        "ToolUninstallRequest",
        "ToolForgetRequest",
        "ToolAdoptRequest",
        "ToolLinkRequest",
        "ToolUnlinkRequest",
        "ToolApplyRequest",
        "ToolImportRequest",
    ],
)

(
    commands: [
        (
            id: "tool",
            name: "tools",
            about: Some("Manage vmux tools and dotfiles"),
            subcommand_required: true,
            commands: [
                (id: "tool.status", name: "status"),
                (id: "tool.apply", name: "apply"),
                (
                    id: "tool.import",
                    name: "import",
                    subcommand_required: true,
                    commands: [
                        (
                            id: "tool.import.homebrew",
                            name: "homebrew",
                            arguments: [
                                (id: "path", index: Some(1), required: true, value_name: Some("BREWFILE")),
                            ],
                        ),
                        (
                            id: "tool.import.npm",
                            name: "npm",
                            arguments: [
                                (id: "path", index: Some(1), required: true, value_name: Some("PACKAGE_JSON")),
                            ],
                        ),
                        (
                            id: "tool.import.mcp",
                            name: "mcp",
                            arguments: [
                                (id: "path", index: Some(1), value_name: Some("CONFIG")),
                            ],
                        ),
                        (
                            id: "tool.import.dotfiles",
                            name: "dotfiles",
                            arguments: [
                                (id: "path", index: Some(1), value_name: Some("DIRECTORY")),
                            ],
                        ),
                    ],
                ),
                (
                    id: "tool.adopt",
                    name: "adopt",
                    arguments: [
                        (id: "path", index: Some(1), required: true, value_name: Some("PATH")),
                        (id: "package", long: Some("package"), required: true, value_name: Some("PACKAGE")),
                    ],
                ),
                (
                    id: "tool.unlink",
                    name: "unlink",
                    arguments: [
                        (id: "package", index: Some(1), required: true, value_name: Some("PACKAGE")),
                    ],
                ),
            ],
        ),
    ],
)

    (key: "crates/feature/vmux_vault/src/storage.rs||struct:VaultStorage", owner: "crates/feature/vmux_vault/src/host/key.rs||struct:AcceptedStorage", lifetime: "Immutable captured paths belong to the accepted namespace or operation; workers receive this exact snapshot, never ambient current paths."),
    (key: "crates/feature/vmux_vault/src/storage/recovery.rs||struct:VaultRecovery", owner: "crates/feature/vmux_vault/src/host.rs||struct:VaultRecoveryState", lifetime: "The existing recovery service contains only captured paths; the canonical recovery component and accepted worker loan retain those paths. Unchanged create_with/unlock_with workflows remain exact migration debt."),
    (key: "crates/feature/vmux_vault/src/storage/status.rs||struct:VaultStatus", owner: "crates/feature/vmux_vault/src/host.rs||struct:VaultScanTask", lifetime: "One accepted scan owns the native observation in its concrete Task result until generation validation and read-only projection; no independent status mutation authority."),
    (key: "crates/feature/vmux_vault/src/state.rs||struct:VaultSnapshot", owner: "crates/feature/vmux_vault/src/host.rs||struct:VaultRegistry", lifetime: "One-way Vault UI snapshot derived from the accepted canonical scan; keys and grants belong to separate canonical Vault entities."),
    (key: "crates/feature/vmux_vault/src/host.rs||struct:VaultOperationOutput", owner: "crates/feature/vmux_vault/src/host.rs||struct:VaultOperationTask", lifetime: "One concrete accepted task result through native drain and generation validation; output is projected only after completion."),
    (key: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:KeyOrigin", owner: "crates/feature/vmux_vault/src/host/key.rs||struct:KeyRequester", lifetime: "Captured operation/namespace/generation/admission identity on the actual accepted key request; copies in the typed port carry that same identity."),
    (key: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:LoadKeyRequest", owner: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:KeyIngress", lifetime: "One typed load packet retained in the operation-owned receiver until the registered receive_load system materializes its canonical request."),
    (key: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:ObserveKeyRequest", owner: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:KeyIngress", lifetime: "One typed silent observation packet retained in the operation-owned receiver until registered ingress; no native lookup or authorization on transport."),
    (key: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:CreateKeyRequest", owner: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:KeyIngress", lifetime: "One typed create intent retained in the operation-owned receiver; registered systems sequence random generation, durable write and publication."),
    (key: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:StoreKeyRequest", owner: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:KeyIngress", lifetime: "One typed store packet retains its zeroizing input until ingress moves it to the accepted write; transport contains no store/retry workflow."),
    (key: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:KeyObservation", owner: "crates/feature/vmux_vault/src/storage/keys/port.rs||struct:KeyPort", lifetime: "A borrowed synchronous KeyStore interface sends only the observing channel packet on its operation-owned typed port; unexpected create/store calls remain subject to ECS grants."),
    (key: "crates/feature/vmux_vault/src/storage/keys.rs||struct:KeyWriteReceipt", owner: "crates/feature/vmux_vault/src/host/key_io.rs||struct:StoreTask", lifetime: "One native durable-write receipt distinguishes a newly created wrapped file from replacement until registered drain; stale completion never deletes another owner file."),
    (key: "crates/feature/vmux_vault/src/storage/keys.rs||const:LOCKED", owner: "crates/feature/vmux_vault/src/host/key.rs||struct:KeyResult", lifetime: "The canonical key result owns its fixed locked diagnostic constructor; registered systems decide refusal, and native read uses the same diagnostic."),
    (key: "crates/feature/vmux_vault/src/storage/recovery.rs||struct:GeneratedRecoveryKey", owner: "crates/feature/vmux_vault/src/host.rs||struct:VaultRecoveryState", lifetime: "The actual pending_key field retains one zeroizing recovery capability until confirmation, consumption or native completion; generated output moves into that same canonical recovery owner."),
    (key: "crates/feature/vmux_vault/src/host.rs||enum:VaultOperationTarget", owner: "crates/feature/vmux_vault/src/host.rs||struct:VaultOperationContext", lifetime: "The accepted operation owns its one reply destination (webview or automatic background); typed request components select work, and this value only controls UI reply projection."),

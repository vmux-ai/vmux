(
    commands: [
            (
                id: "browser_prev_page",
                label: "Back",
                group: "Browser > Navigation",
                accelerator: Some("super+["),
                mcp: Some((description: "Back", allow_agent: true)),
            ),
            (
                id: "browser_next_page",
                label: "Forward",
                group: "Browser > Navigation",
                accelerator: Some("super+]"),
                mcp: Some((description: "Forward", allow_agent: true)),
            ),
            (
                id: "browser_reload",
                label: "Reload",
                group: "Browser > Navigation",
                accelerator: Some("super+r"),
                shortcuts: [(shortcut: Direct("Super+r"), when: None)],
                mcp: Some((description: "Reload", allow_agent: true)),
            ),
            (
                id: "browser_hard_reload",
                label: "Hard Reload",
                group: "Browser > Navigation",
                accelerator: Some("super+shift+r"),
                shortcuts: [(shortcut: Direct("Super+Shift+R"), when: None)],
                mcp: Some((description: "Hard Reload", allow_agent: true)),
            ),
            (
                id: "browser_stop",
                label: "Stop Loading",
                group: "Browser > Navigation",
                accelerator: Some("super+."),
                hidden: true,
                mcp: Some((description: "Stop Loading", allow_agent: true)),
            ),
            (
                id: "open_in_place",
                label: "Open Here",
                group: "Browser > Open",
                mcp: Some((
                    description: "Navigate the currently focused stack to the given URL. Equivalent to the user typing a URL in the address bar. Use when the user asks to 'go to', 'navigate to', or 'open' a URL without specifying placement; the current page is replaced. If url is omitted, opens the configured startup URL.",
                    input_schema: Some((
                        type: Object,
                        properties: {
                            "url": (
                                type: String,
                                description: Some("Absolute URL to open. If omitted, opens the startup URL."),
                            ),
                        },
                    )),
                )),
            ),
            (
                id: "browser_zoom_in",
                label: "Zoom In",
                group: "Browser > View",
                accelerator: Some("super+="),
                mcp: Some((description: "Zoom In", allow_agent: true)),
            ),
            (
                id: "browser_zoom_out",
                label: "Zoom Out",
                group: "Browser > View",
                accelerator: Some("super+-"),
                mcp: Some((description: "Zoom Out", allow_agent: true)),
            ),
            (
                id: "browser_zoom_reset",
                label: "Actual Size",
                group: "Browser > View",
                accelerator: Some("super+0"),
                mcp: Some((description: "Actual Size", allow_agent: true)),
            ),
            (
                id: "browser_dev_tools",
                label: "Developer Tools",
                group: "Browser > View",
                accelerator: Some("super+alt+i"),
                mcp: Some((description: "Developer Tools", allow_agent: true)),
            ),
            (
                id: "browser_open_history",
                label: "History",
                group: "Browser > Bar",
                accelerator: Some("super+y"),
                mcp: Some((description: "History")),
            ),
    ],
    tools: [
            (
                name: "browser_navigate",
                description: "Navigate the active webview to a URL, or open a URL in a target pane. This is the primary tool for web access. When navigating the focused browser page, it returns the page semantic snapshot after loading. vmux://terminal/ opens a terminal, vmux://spaces/ opens spaces, and vmux://services/ opens the process monitor. Other vmux:// URLs are rejected.",
                input_schema: (
                    type: Object,
                    required: ["url"],
                    properties: {
                        "url": (type: String),
                        "pane": (type: String),
                    },
                ),
            ),
            (
                name: "browser_go_back",
                description: "Navigate the active or specified browser pane back one page in history.",
                input_schema: (
                    type: Object,
                    properties: {"pane": (type: String)},
                ),
            ),
            (
                name: "browser_go_forward",
                description: "Navigate the active or specified browser pane forward one page in history.",
                input_schema: (
                    type: Object,
                    properties: {"pane": (type: String)},
                ),
            ),
            (
                name: "browser_history_search",
                description: "Search vmux browsing history. Returns entries ranked by frecency.",
                input_schema: (
                    type: Object,
                    required: ["query"],
                    properties: {
                        "query": (type: String),
                        "limit": (type: Integer, minimum: Some(0), maximum: Some(100)),
                    },
                ),
            ),
            (
                name: "browser_install_extension",
                description: "Install a browser extension from a supported extension-store URL or a 32-character extension ID. The extension activates after the next vmux relaunch and runs only in windowed browse panes on macOS.",
                input_schema: (
                    type: Object,
                    required: ["source"],
                    properties: {"source": (type: String)},
                ),
            ),
            (
                name: "browser_snapshot",
                description: r#"Read the current page's DOM as a compact semantic snapshot. Returns JSON with the page url/title and a list of interactive elements, each with a stable `ref`, `role`, `name`, `value`, `bbox` ([x,y,w,h] in CSS px), and `state` flags. Use the `ref` values to target later interaction tools. Pass `target` = a pane:<id> or stack:<id> from read_layout to pick a specific page; defaults to the focused page."#,
                input_schema: (
                    type: Object,
                    properties: {
                        "target": (
                            type: String,
                            description: Some("Optional pane:<id> or stack:<id>; if omitted, an agent caller's own browser pane (resolved via anchor), else the focused page."),
                        ),
                    },
                ),
            ),
            (
                name: "browser_scroll",
                description: r#"Scroll the visible browser page so the user can watch, then return the post-scroll snapshot (same shape as browser_snapshot, including viewport + inViewport flags). Pass exactly one of `to` ("top" or "bottom") or `delta` (pixels; positive = down, e.g. one screen is about the snapshot's viewport.height). Pass `target` = pane:<id> or stack:<id> to pick a page; defaults to the focused page. Prefer scrolling to read long pages instead of assuming off-screen content."#,
                input_schema: (
                    one_of: [
                        (
                            type: Object,
                            required: ["to"],
                            properties: {
                                "to": (
                                    type: String,
                                    description: Some("Scroll to page top or bottom."),
                                    values: ["top", "bottom"],
                                ),
                                "target": (
                                    type: String,
                                    description: Some("Optional pane:<id> or stack:<id>; if omitted, an agent caller's own browser pane (resolved via anchor), else the focused page."),
                                ),
                            },
                        ),
                        (
                            type: Object,
                            required: ["delta"],
                            properties: {
                                "delta": (
                                    type: Integer,
                                    description: Some("Scroll by pixels; positive = down."),
                                    minimum: Some(-2147483648),
                                    maximum: Some(2147483647),
                                ),
                                "target": (
                                    type: String,
                                    description: Some("Optional pane:<id> or stack:<id>; if omitted, an agent caller's own browser pane (resolved via anchor), else the focused page."),
                                ),
                            },
                        ),
                    ],
                ),
            ),
        ],
    ],
    policy: (
        extension: (
            chromium_major: 148,
            entries: [
                (platform: "macos", namespace: "runtime", member: "sendMessage", kind: Method, status: Untested, owner: None, scenario: None),
                (platform: "macos", namespace: "storage.local", member: "get", kind: Method, status: Untested, owner: None, scenario: None),
                (platform: "macos", namespace: "tabs", member: "query", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:the_active_tab_of_the_focused_window_is_the_one_a_content_script_sits_in")),
                (platform: "macos", namespace: "tabs", member: "get", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:getting_a_tab_the_model_does_not_hold_fails_the_way_chrome_fails")),
                (platform: "macos", namespace: "windows", member: "WINDOW_ID_NONE", kind: Property, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "macos", namespace: "windows", member: "WINDOW_ID_CURRENT", kind: Property, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "macos", namespace: "windows", member: "get", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "macos", namespace: "windows", member: "getCurrent", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:current_window_resolves_extension_page_url")),
                (platform: "macos", namespace: "windows", member: "getLastFocused", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "macos", namespace: "windows", member: "getAll", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "macos", namespace: "windows", member: "create", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "macos", namespace: "windows", member: "update", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "macos", namespace: "windows", member: "remove", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "macos", namespace: "windows", member: "onCreated", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "macos", namespace: "windows", member: "onRemoved", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "macos", namespace: "windows", member: "onFocusChanged", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "macos", namespace: "windows", member: "onBoundsChanged", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "linux", namespace: "runtime", member: "sendMessage", kind: Method, status: Untested, owner: None, scenario: None),
                (platform: "linux", namespace: "storage.local", member: "get", kind: Method, status: Untested, owner: None, scenario: None),
                (platform: "linux", namespace: "tabs", member: "query", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:the_active_tab_of_the_focused_window_is_the_one_a_content_script_sits_in")),
                (platform: "linux", namespace: "tabs", member: "get", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:getting_a_tab_the_model_does_not_hold_fails_the_way_chrome_fails")),
                (platform: "linux", namespace: "windows", member: "WINDOW_ID_NONE", kind: Property, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "linux", namespace: "windows", member: "WINDOW_ID_CURRENT", kind: Property, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "linux", namespace: "windows", member: "get", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "linux", namespace: "windows", member: "getCurrent", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:current_window_resolves_extension_page_url")),
                (platform: "linux", namespace: "windows", member: "getLastFocused", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "linux", namespace: "windows", member: "getAll", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "linux", namespace: "windows", member: "create", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "linux", namespace: "windows", member: "update", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "linux", namespace: "windows", member: "remove", kind: Method, status: Bridged, owner: Some("vmux"), scenario: Some("unit:creates_queries_updates_and_removes_extension_window")),
                (platform: "linux", namespace: "windows", member: "onCreated", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "linux", namespace: "windows", member: "onRemoved", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "linux", namespace: "windows", member: "onFocusChanged", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
                (platform: "linux", namespace: "windows", member: "onBoundsChanged", kind: Event, status: Bridged, owner: Some("vmux"), scenario: Some("unit:windows_namespace_is_fully_shimmed")),
            ],
        ),
    ),
)

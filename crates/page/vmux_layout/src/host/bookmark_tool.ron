[
    (
        kind: bookmark_list,
        description: r#"List all pins (favicon quick-access) and bookmarks (saved pages, optionally inside folders) for the current profile. Returns JSON: {pins:[{uuid,url,title,favicon_url}], roots:[ {kind:"entry",...} | {kind:"folder",uuid,name,collapsed,children:[...]} ]}."#,
        input_schema: (type: Object),
    ),
    (
        kind: bookmark_add,
        description: r#"Save a page as a bookmark. Optional folder (a folder uuid from bookmark_list) nests it; omit for top level."#,
        input_schema: (
            type: Object,
            required: ["url"],
            properties: {
                "url": (type: String),
                "title": (type: String),
                "favicon_url": (type: String),
                "folder": (type: String),
            },
        ),
    ),
    (
        kind: bookmark_remove,
        description: "Remove a bookmark by its uuid (from bookmark_list).",
        input_schema: (
            type: Object,
            required: ["uuid"],
            properties: {"uuid": (type: String)},
        ),
    ),
    (
        kind: bookmark_pin,
        description: r#"Pin a page to the favicon grid. Provide a bookmark uuid to promote an existing bookmark, OR a url (+optional title/favicon_url) to pin a page directly."#,
        input_schema: (
            one_of: [
            (
                type: Object,
                required: ["uuid"],
                properties: {"uuid": (type: String)},
            ),
            (
                type: Object,
                required: ["url"],
                properties: {
                    "url": (type: String),
                    "title": (type: String),
                    "favicon_url": (type: String),
                },
            ),
        ]),
    ),
    (
        kind: bookmark_unpin,
        description: "Unpin a pin by its uuid (from bookmark_list).",
        input_schema: (
            type: Object,
            required: ["uuid"],
            properties: {"uuid": (type: String)},
        ),
    ),
    (
        kind: bookmark_folder_create,
        description: "Create a bookmark folder with the given name.",
        input_schema: (
            type: Object,
            required: ["name"],
            properties: {"name": (type: String)},
        ),
    ),
]

#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "pre-push: formatting, diff, and source conventions"
./scripts/build-storage.sh --test
bash scripts/test-build-storage.sh
cargo fmt --all -- --check
git diff --check
cargo test -p vmux_macro --test source_conventions
